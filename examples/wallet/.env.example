# ==============================================================================
# Ciphra — Environment Configuration Template
# Copy this file to .env and populate your credentials
# ==============================================================================

# Network selection: devnet | mainnet
VITE_ZOLANA_NETWORK=devnet

# Helius RPC & API Configuration (https://dashboard.helius.dev/)
VITE_HELIUS_API_KEY=your-helius-api-key-here
VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=your-helius-api-key-here

# Confidential SPL USDC Token Mint
# Devnet default: 3XTtZxGjTNrzfaWHiNfqEQck5yJ4R7n6WbWgwhmRRoPf
# Mainnet default: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
VITE_DEVNET_USDC_MINT=3XTtZxGjTNrzfaWHiNfqEQck5yJ4R7n6WbWgwhmRRoPf

# Optional Pre-Funded Devnet Payer Keypair
# Pass a Solana CLI keypair byte array e.g. [236,230,...] or 64-char hex seed
# Leave empty in public production deployments to use Phantom, Solflare, or fresh ephemeral burners
VITE_FUNDED_KEYPAIR=
