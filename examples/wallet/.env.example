# Ciphra devnet demo.
# The mainnet path is untested. Do not use this app for production funds.
#
# Every VITE_* value is inlined into the public JavaScript bundle.
# Never put a private key, a seed, or an unrestricted API key in this file.
# Anyone who loads the page can read these values. Restrict a Helius key
# before you paste it, or leave the RPC on the public devnet endpoint.

# This demo expects devnet.
VITE_ZOLANA_NETWORK=devnet

# Optional. If you set these, they are public in the bundle.
VITE_HELIUS_API_KEY=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional devnet USDC mint override.
# VITE_DEVNET_USDC_MINT=

# Protocol fee treasury (0.50%). Public in the bundle, like every other VITE_* value.
# On devnet, an empty value falls back to the connected wallet.
# On any other network the app refuses to run payroll until this is a treasury
# address that is not the connected wallet.
# VITE_PROTOCOL_FEE_COLLECTOR=

# Mainnet is locked unless this is exactly true. It is public in the bundle.
# Leave it unset until a mainnet build has been tested and reviewed.
# VITE_ENABLE_MAINNET=
# Live Jupiter (mainnet liquidity) is off unless this is exactly true,
# or the unlocked network is mainnet. Public in the bundle.
# VITE_ENABLE_LIVE_JUPITER=
# Fee token accounts for the 0.50% Jupiter hook. Public addresses, not secrets.
# The swap fails if the pair's WSOL or USDC side has no matching account.
# VITE_FEE_ATA_WSOL=
# VITE_FEE_ATA_USDC=

# Server only. Set RELAYER_PRIVATE_KEY in the Vercel (or local server) environment.
# Never prefix it with VITE_. Never put a real key in this file. It is a hot wallet:
# keep it minimally funded.
# RELAYER_PRIVATE_KEY=
# RELAYER_RPC_URL=https://api.devnet.solana.com
# JUPITER_API_KEY=

# Do not set VITE_FUNDED_KEYPAIR.
# A key placed here is shipped in the public bundle. Leave it unset and
# connect Phantom or Solflare instead.
# VITE_FUNDED_KEYPAIR=
